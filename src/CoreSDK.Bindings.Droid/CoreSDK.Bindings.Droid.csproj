<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>

    <!-- Assembly & NuGet Info -->
    <Title>ZendeskCore</Title>
    <Description>Xamarin.Android binding library for Zendesk Core SDK</Description>
    <Company>Softeq Development Corporation</Company>
    <Copyright>Copyright © 2024 Softeq Development Corporation</Copyright>
    <Version>4.2.1</Version>
    <Authors>Softeq Development Corp.</Authors>
    <Owners>Softeq Development Corp.</Owners>
    <PackageId>Softeq.ZendeskCore.Droid</PackageId>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Softeq/Zendesk-xamarin-android</PackageProjectUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageTags>zendesk;android;xamarin;binding;softeq;library</PackageTags>
    <PackageReleaseNotes>Migration to .NET9</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE.txt" Visible="False" Pack="true" PackagePath="" />
    <None Include="../../images/icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AndroidLibrary Include="../../original/CoreSDK/core-4.2.1.aar" Bind="true" />
    <AndroidJavaSource Include="../../original/CoreSDK/core-4.2.1-sources.jar" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JavaCommon.Bindings.Droid\JavaCommon.Bindings.Droid.csproj" />
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="Square.OkHttp3" Version="4.12.0.10" />
      <PackageReference Include="Square.OkHttp3.LoggingInterceptor" Version="4.12.0.10" />
      <PackageReference Include="Square.Retrofit2.ConverterGson" Version="2.11.0" />
      <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.3.0.4" />
      <PackageReference Include="Xamarin.AndroidX.Legacy.Support.Core.Utils" Version="1.0.0.14" />
      <PackageReference Include="Xamarin.Google.Dagger" Version="2.48.1.2" />
      <PackageReference Include="Com.Jakewharton.Disklrucache" Version="2.0.2" />
      <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.20" />
  </ItemGroup>
</Project>